VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# 隠しコマンド「ラッキーモード」（卓で自分の名前を3秒長押し）を有効にするか。
# 未指定または 1 で有効、0 で完全に無効（長押ししても何も起きず、タイトルの 7 も明るくならない）。
# 配布ビルドで隠し要素を外したいときに 0 を指定する。
VITE_ENABLE_LUCKY=1

# 「設定・情報」画面に出すバージョン表記。未指定なら src/version.ts の既定値を使う。
# ネイティブ（iOS）のバージョンと揃えたいときに指定する。
# VITE_APP_VERSION=1.0.0
